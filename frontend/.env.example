# Другой ПК — только фронт (backend живёт на Raspberry Pi).
#
#   git clone …  или  git pull
#   cd frontend
#   npm install
#   copy .env.example .env.local
#   ← в .env.local пропиши IP Pi (сейчас часто 172.20.10.6 или 172.20.10.4)
#   npm run dev
#   браузер: http://localhost:5173/betaflight
#
# Этот ПК и Pi должны быть в одной Wi‑Fi. После смены IP — снова npm run dev.

VITE_DRONE_API_URL=http://172.20.10.6:8000
VITE_VISION_TRACKER_URL=http://172.20.10.6:8001
