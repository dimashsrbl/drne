# Вариант A (проще): ничего не копируй — в git уже есть .env.development с IP Pi.
#   cd frontend && npm install && npm run dev
#
# Вариант B: свой IP Pi → скопируй в .env.local (в git не кладём):
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (Linux/macOS)
#
# .env.local перебивает .env.development. После смены — перезапусти npm run dev.

VITE_DRONE_API_URL=http://192.168.1.198:8000
VITE_VISION_TRACKER_URL=http://192.168.1.198:8001
