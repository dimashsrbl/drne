# Dev-режим: Vite читает этот файл автоматически (npm run dev).
# В git — чтобы фронт с любого ПК в сети ходил на Pi без копирования .env.local.
# Другой IP Pi → создай frontend/.env.local (перебивает эти значения, в git не кладём).

VITE_DRONE_API_URL=http://192.168.1.198:8000
VITE_VISION_TRACKER_URL=http://192.168.1.198:8001
