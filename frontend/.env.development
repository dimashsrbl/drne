# Dev-режим: Vite читает этот файл автоматически (npm run dev).
# IP Pi на хотспоте телефона часто прыгает (.4 / .6) — если вкладка не «Pixhawk»,
# создай frontend/.env.local (не в git) с актуальным IP и перезапусти npm run dev.
# .env.development.local тоже перебивает этот файл — не оставляй там старый IP.

VITE_DRONE_API_URL=http://172.20.10.6:8000
VITE_VISION_TRACKER_URL=http://172.20.10.6:8001
