DRONE_BACKEND_PROFILE=bob57_bridge

# USB Betaflight FC на Pi (Configurator закрыт во время полёта)
DRONE_BETAFLIGHT_PORT=/dev/ttyACM0
DRONE_BETAFLIGHT_BAUD=115200
DRONE_BETAFLIGHT_RC_HZ=25

# Как map в Betaflight CLI (AETR1234)
DRONE_BETAFLIGHT_RC_MAP=AETR
DRONE_BETAFLIGHT_ARM_CHANNEL=5
DRONE_BETAFLIGHT_ANGLE_CHANNEL=6
DRONE_BETAFLIGHT_ENABLE_ANGLE=true

# GPS hold на Pi (без POSITION_HOLD в Betaflight) — держит точку взлёта на neutral/hold_alt.
DRONE_BETAFLIGHT_GPS_HOLD_ENABLED=true
DRONE_BETAFLIGHT_GPS_HOLD_P_GAIN=20
DRONE_BETAFLIGHT_GPS_HOLD_MAX_US=85
DRONE_BETAFLIGHT_GPS_HOLD_DEADBAND_M=0.4
DRONE_BETAFLIGHT_GPS_HOLD_MIN_SATS=6
DRONE_BETAFLIGHT_GPS_HOLD_MIN_FIX=2

# GPS Position Hold на FC — только если в прошивке BF есть POSITION_HOLD. Иначе 0.
DRONE_BETAFLIGHT_POSHOLD_CHANNEL=0
DRONE_BETAFLIGHT_POSHOLD_US=2000
DRONE_BETAFLIGHT_POSHOLD_AUTO=false

# ARM/disarm: rcData[Throttle] < mincheck (1050) — строго ниже
DRONE_BETAFLIGHT_IDLE_THROTTLE_US=988
DRONE_BETAFLIGHT_ARM_SWITCH_US=2000
DRONE_BETAFLIGHT_ARM_HOLD_S=3.0

# Баро-взлёт ~1 м (BOB57 с пропами)
DRONE_BETAFLIGHT_MAX_THROTTLE_US=1550
DRONE_BETAFLIGHT_ALT_HOVER_US=1410
DRONE_BETAFLIGHT_ALT_P_GAIN=70
DRONE_BETAFLIGHT_ALT_P_GAIN_NEAR=55
DRONE_BETAFLIGHT_ALT_MAX_CLIMB_US=1440
DRONE_BETAFLIGHT_ALT_MAX_DESCEND_US=1280
DRONE_BETAFLIGHT_ALT_HOLD_MIN_US=1405
DRONE_BETAFLIGHT_ALT_TOLERANCE_M=0.12
DRONE_BETAFLIGHT_ALT_THROTTLE_SLEW_US=14
DRONE_BETAFLIGHT_LAND_THROTTLE_US=1140
DRONE_BETAFLIGHT_LAND_SECONDS=12
DRONE_BETAFLIGHT_LAND_FINAL_M=0.18
DRONE_BETAFLIGHT_LAND_P_GAIN=38
DRONE_BETAFLIGHT_LAND_SLEW_US=7
DRONE_BETAFLIGHT_LAND_TOUCHDOWN_S=1.2
DRONE_BETAFLIGHT_DISARM_HOLD_S=2.5
# Нет status от UI 4 с → Pi сам шлёт DISARM (обрыв Wi‑Fi)
DRONE_BETAFLIGHT_CLIENT_WATCHDOG_ENABLED=true
DRONE_BETAFLIGHT_CLIENT_HEARTBEAT_TIMEOUT_S=4.0
# Обрыв связи: плавно снизить газ до idle (988 µs) за 15 с, затем DISARM
DRONE_BETAFLIGHT_LINK_LOSS_SOFT_LAND_ENABLED=true
DRONE_BETAFLIGHT_LINK_LOSS_LAND_S=15
# Лимит всей миссии (с). Пусто/0 — выкл. UI может переопределить в запросе.
DRONE_BETAFLIGHT_MISSION_MAX_S=40

# Vision на том же Pi (localhost)
DRONE_VISION_TRACKER_URL=http://127.0.0.1:8001
DRONE_BETAFLIGHT_TRACK_TARGET_ALT_M=1.0

# ---- Unity sim (Windows, DRONE_BACKEND_PROFILE=unity_sim) ------------
# DRONE_BACKEND_PROFILE=unity_sim
# DRONE_UNITY_CMD_HOST=127.0.0.1
# DRONE_UNITY_CMD_PORT=15000
# DRONE_UNITY_TELEM_PORT=15001
# DRONE_UNITY_PROTOCOL_V2=true