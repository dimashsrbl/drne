DRONE_BACKEND_PROFILE=inav
# GPIO UART:
DRONE_MAVLINK_CONNECTION=/dev/serial0
# USB (если FC воткнут в USB):
# DRONE_MAVLINK_CONNECTION=/dev/ttyACM0
# DRONE_MAVLINK_CONNECTION=/dev/ttyUSB0
DRONE_MAVLINK_BAUD=115200
DRONE_MAVLINK_FALLBACKS=
DRONE_INAV_RC_TRANSPORT=mavlink

# ---- Betaflight (bob57_bridge) — пример для Pi ----
# DRONE_BACKEND_PROFILE=bob57_bridge
# DRONE_BETAFLIGHT_PORT=/dev/serial0
# DRONE_BETAFLIGHT_BAUD=115200
# DRONE_VISION_TRACKER_URL=http://192.168.40.XXX:8001
# Баро-взлёт 1 м (мягче = меньше перелёт):
# DRONE_BETAFLIGHT_ALT_HOVER_US=1410
# DRONE_BETAFLIGHT_ALT_P_GAIN=70
# DRONE_BETAFLIGHT_ALT_MAX_CLIMB_US=1440
# DRONE_BETAFLIGHT_ALT_HOLD_MIN_US=1405
# DRONE_BETAFLIGHT_ALT_OVERSHOOT_M=0.20
# DRONE_BETAFLIGHT_LAND_THROTTLE_US=1080
# DRONE_BETAFLIGHT_LAND_SECONDS=8
