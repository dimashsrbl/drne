# Raspberry Pi — шаблон. Скопируй:  cp .env.example.pi .env
# Pixhawk 2.4.8 + ArduCopter по UART (TELEM2 → /dev/serial0).
# MSP / Betaflight больше не основной профиль.

# ---- ArduPilot / MAVLink (основной) ----
DRONE_BACKEND_PROFILE=ardupilot
# UART на GPIO Pi5 (TELEM2 TX/RX/GND). USB ACM0 для Pixhawk обычно не нужен.
DRONE_MAVLINK_CONNECTION=/dev/serial0
# Должно совпадать с SERIAL2_BAUD на Pixhawk: 115 = 115200, 921 = 921600
DRONE_MAVLINK_BAUD=115200
DRONE_MAVLINK_FALLBACKS=

# На реальном FC force-arm и relax preflight — выкл
DRONE_SITL_FORCE_ARM=false
DRONE_SITL_RELAX_PREFLIGHT=false

# guided = по шагам (конструктор + wait). auto = MISSION на FC (/nav/route).
DRONE_ARDUPILOT_MISSION_MODE=guided
DRONE_ARDUPILOT_MIN_GPS_SATS=6
DRONE_ARDUPILOT_GOTO_TOL_M=3.0

DRONE_VISION_TRACKER_URL=http://127.0.0.1:8001

# ---- Betaflight MSP (legacy BOB57, не использовать с Pixhawk) ----
# DRONE_BACKEND_PROFILE=bob57_bridge
# DRONE_BETAFLIGHT_PORT=/dev/ttyACM0
# DRONE_BETAFLIGHT_BAUD=115200
