# Скопируй на Pi:  cp .env.example .env
# Рабочий .env в git не кладём — только этот шаблон.
# После правок:  sudo systemctl restart vision-tracker

# CSI Raspberry Pi Camera (Picamera2). USB: /dev/video0 или /dev/video1
VISION_VIDEO_SOURCE=picamera
# VISION_V4L_DEVICES=/dev/video0,/dev/video1
VISION_CAPTURE_WIDTH=640
VISION_PREVIEW_MAX_WIDTH=640
VISION_PREVIEW_JPEG_QUALITY=55
VISION_BUFFER_DRAIN=3
VISION_YOLO_IMGSZ=320
VISION_DETECT_EVERY=1
VISION_LOCK_DETECT_EVERY=2
VISION_OPENCV_TRACKER=on
VISION_OPENCV_TRACKER_KIND=KCF
VISION_YOLO_MODEL=yolo11n.pt
VISION_CAMERA_FALLBACK=0,1,2

# IP-камера (раскомментируй; пароль только в локальном .env):
# VISION_VIDEO_SOURCE=http://192.168.88.47
# VISION_CAMERA_USER=admin
# VISION_CAMERA_PASSWORD=your_password_here
# VISION_CAMERA_STREAM_PATH=/videostream.cgi
# VISION_EVENT_LOG_PATH=vision-events.jsonl
