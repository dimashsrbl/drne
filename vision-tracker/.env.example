# Скопируй в .env и заполни. Реальный .env в репозиторий не кладём.

# Веб-камера на Pi: лучше путь, не индекс (OpenCV index 0 часто не та нода)
VISION_VIDEO_SOURCE=/dev/video0
# или индекс: VISION_VIDEO_SOURCE=0
# явный список узлов: VISION_V4L_DEVICES=/dev/video0,/dev/video1
VISION_CAPTURE_WIDTH=480
VISION_PREVIEW_MAX_WIDTH=480
VISION_PREVIEW_JPEG_QUALITY=50
VISION_YOLO_IMGSZ=256
VISION_BUFFER_DRAIN=6
VISION_DETECT_EVERY=2
VISION_LOCK_DETECT_EVERY=2
VISION_OPENCV_TRACKER=on
VISION_OPENCV_TRACKER_KIND=KCF
VISION_YOLO_MODEL=yolo11n.pt

# IP-камера (раскомментируй при необходимости):
# VISION_VIDEO_SOURCE=http://192.168.88.47
# VISION_CAMERA_USER=admin
# VISION_CAMERA_PASSWORD=your_password_here
# VISION_CAMERA_STREAM_PATH=/videostream.cgi
# VISION_EVENT_LOG_PATH=vision-events.jsonl
