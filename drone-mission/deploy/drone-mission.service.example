[Unit]
Description=Drone mission backend (FastAPI, INAV)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/drone/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/drone/backend/.venv/bin/uvicorn app.main_mission_only:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
